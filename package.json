{
  "name": "tinyfish",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json --noEmit && esbuild server/server.ts --platform=node --target=node20 --format=esm --bundle --outfile=dist-server/index.js --packages=external --tsconfig=tsconfig.server.json",
    "build:all": "npm run build && npm run build:server",
    "start": "node dist-server/index.js",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@types/node": "^24.19.2",
    "dotenv": "^18.0.9",
    "esbuild": "^0.28.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~7.0.2"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "vite": "^8.3.5"
  }
}
